<Bindings>
    <Binding name="VIGNETTERADAR_RAISE_LAUNCHER" header="VIGNETTERADAR" category="ADDONS" runOnUp="true">
        VignetteRadar_RaiseLauncher(keystate)
    </Binding>
    <Binding name="VIGNETTERADAR_HOLD_LENS" category="ADDONS" runOnUp="true">
        VignetteRadar_HoldLens(keystate)
    </Binding>
    <Binding name="VIGNETTERADAR_FOCUS_NEXT" category="ADDONS">
        VignetteRadar_CycleWorldFocus(1)
    </Binding>
    <Binding name="VIGNETTERADAR_FOCUS_PREVIOUS" category="ADDONS">
        VignetteRadar_CycleWorldFocus(-1)
    </Binding>
    <Binding name="VIGNETTERADAR_TOGGLE_RADAR" category="ADDONS">
        VignetteRadar_ToggleRadar()
    </Binding>
    <Binding name="VIGNETTERADAR_TOGGLE_SETTINGS" category="ADDONS">
        VignetteRadar_ToggleSettings()
    </Binding>
    <Binding name="VIGNETTERADAR_TOGGLE_BEARING" category="ADDONS">
        VignetteRadar_ToggleBearingBar()
    </Binding>
    <Binding name="VIGNETTERADAR_TOGGLE_CONSTELLATION" category="ADDONS">
        VignetteRadar_ToggleConstellation()
    </Binding>
    <Binding name="VIGNETTERADAR_TOGGLE_ROUTE" category="ADDONS">
        VignetteRadar_ToggleAutoRoute()
    </Binding>
    <Binding name="VIGNETTERADAR_PIN_ZYGOR" category="ADDONS">
        VignetteRadar_PinZygorStep()
    </Binding>
    <Binding name="VIGNETTERADAR_ROUTE_RARE" category="ADDONS">
        VignetteRadar_StartNearestRoute("rare")
    </Binding>
    <Binding name="VIGNETTERADAR_ROUTE_TREASURE" category="ADDONS">
        VignetteRadar_StartNearestRoute("treasure")
    </Binding>
    <Binding name="VIGNETTERADAR_ROUTE_QUEST" category="ADDONS">
        VignetteRadar_StartNearestRoute("quest")
    </Binding>
    <Binding name="VIGNETTERADAR_ROUTE_CLOSEST" category="ADDONS">
        VignetteRadar_StartNearestRoute("closest")
    </Binding>
    <Binding name="VIGNETTERADAR_QUEST_STEP_PREVIOUS" category="ADDONS">
        VignetteRadar_NavigateQuestRoute(-1)
    </Binding>
    <Binding name="VIGNETTERADAR_QUEST_STEP_NEXT" category="ADDONS">
        VignetteRadar_NavigateQuestRoute(1)
    </Binding>
    <Binding name="VIGNETTERADAR_CLEAR_FOCUS" category="ADDONS">
        VignetteRadar_ClearFocus()
    </Binding>
    <Binding name="CLICK VignetteRadarQuestItemButton:LeftButton" category="ADDONS" />
</Bindings>
